{
  "name": "clause_verdicts",
  "inputs": {
    "domain": { "type": "enum", "values": ["finite", "unbounded"] },
    "program": { "type": "enum", "values": ["correct", "buggy"] },
    "ifPart": { "type": "enum", "values": ["reachable", "unreachable"] },
    "ensures": { "type": "enum", "values": ["pins-output", "trivial"] },
    "trace": { "type": "enum", "values": ["none", "agrees", "disagrees"] }
  },
  "outputs": {
    "verdict": { "type": "enum", "values": ["proved", "evidenced", "violated", "vacuous", "weak"] },
    "evidence": { "type": "enum", "values": ["formal", "empirical", "none"] }
  }
}
