{
  "name": "decision_answer",
  "inputs": {
    "origin": {
      "type": "enum",
      "values": [
        "extraction",
        "consistency-check"
      ]
    },
    "known": {
      "type": "bool"
    },
    "option": {
      "type": "int",
      "min": -1,
      "max": 3
    },
    "again": {
      "type": "bool"
    }
  },
  "outputs": {
    "throws": {
      "type": "bool"
    },
    "chosen": {
      "type": "int",
      "min": -1,
      "max": 3
    },
    "linked": {
      "type": "int",
      "min": 0,
      "max": 2
    },
    "status": {
      "type": "enum",
      "values": [
        "none",
        "proposed",
        "approved",
        "amended"
      ]
    },
    "approvals": {
      "type": "int",
      "min": 0,
      "max": 2
    }
  }
}
