{
  "name": "driven_scenario",
  "inputs": {
    "step": {
      "type": "enum",
      "values": [
        "screen",
        "api",
        "function"
      ]
    },
    "matches": {
      "type": "bool"
    },
    "pixelShare": {
      "type": "int",
      "min": 0,
      "max": 10
    },
    "tolerance": {
      "type": "int",
      "min": 0,
      "max": 5
    },
    "hasReference": {
      "type": "bool"
    },
    "driver": {
      "type": "enum",
      "values": [
        "ok",
        "fails-to-start",
        "timeout"
      ]
    }
  },
  "outputs": {
    "passed": {
      "type": "bool"
    },
    "driverError": {
      "type": "bool"
    },
    "evidence": {
      "type": "enum",
      "values": [
        "empirical",
        "none"
      ]
    }
  }
}
