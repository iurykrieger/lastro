{
  "name": "proved_gate",
  "inputs": {
    "runOk": {
      "type": "bool"
    },
    "allPassed": {
      "type": "bool"
    },
    "judgment": {
      "type": "bool"
    },
    "signoffs": {
      "type": "int",
      "min": 0,
      "max": 3
    },
    "changesRequested": {
      "type": "bool"
    },
    "unexpected": {
      "type": "bool"
    },
    "acceptances": {
      "type": "int",
      "min": 0,
      "max": 3
    },
    "required": {
      "type": "int",
      "min": 1,
      "max": 3
    }
  },
  "outputs": {
    "status": {
      "type": "enum",
      "values": [
        "proving",
        "proved",
        "changes-requested"
      ]
    }
  }
