{
  "name": "reviewer_add",
  "inputs": {
    "existing": {
      "type": "int",
      "min": 1,
      "max": 3
    },
    "inProse": {
      "type": "bool"
    }
  },
  "outputs": {
    "id": {
      "type": "int",
      "min": 1,
      "max": 4
    },
    "status": {
      "type": "enum",
      "values": [
        "proposed",
        "approved",
        "amended",
        "rejected"
      ]
    },
    "notInProse": {
      "type": "bool"
    },
    "byReviewer": {
      "type": "bool"
    }
  }
}
