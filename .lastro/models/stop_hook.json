  "outputs": {
    "block": {
      "type": "bool"
    },
    "attempt": {
      "type": "int",
      "min": 0,
      "max": 8
    },
    "max": {
      "type": "int",
      "min": 0,
      "max": 8
    },
    "proved": {
      "type": "bool"
    },
    "buildFirst": {
      "type": "bool"
    },
    "failuresSent": {
      "type": "bool"
    }
