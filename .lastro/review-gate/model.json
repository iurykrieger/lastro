{
  "name": "review_gate",
  "inputs": {
    "required": { "type": "int", "min": 1, "max": 3 },
    "approvers": { "type": "int", "min": 0, "max": 3 },
    "repeatApprover": { "type": "bool" },
    "lastAction": { "type": "enum", "values": ["none", "amend", "reject"] },
    "decision": { "type": "enum", "values": ["none", "unanswered", "answered"] }
  },
  "outputs": {
    "inSpec": { "type": "bool" },
    "blocked": { "type": "bool" },
    "frozen": { "type": "bool" }
  }
}
