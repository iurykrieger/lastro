{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lastro/sdk": ["../../sdks/typescript/src/index.ts"],
      "@lastro/example-login": ["../../sdks/typescript/examples/login/login.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
