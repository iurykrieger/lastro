{
  "name": "lastro",
  "version": "0.1.0",
  "description": "Deterministic backing for non-deterministic plans: prose -> reviewable intents -> derived proofs -> verification receipts.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "lastro": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./claude": {
      "types": "./dist/src/llm/claude.d.ts",
      "default": "./dist/src/llm/claude.js"
    },
    "./workspace": {
      "types": "./dist/src/workspace.d.ts",
      "default": "./dist/src/workspace.js"
    }
  },
  "scripts": {
    "wasm": "cargo build --release --target wasm32-unknown-unknown -p lastro-core --manifest-path ../../Cargo.toml && mkdir -p wasm && cp ../../target/wasm32-unknown-unknown/release/lastro_core.wasm wasm/",
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "example": "tsc -p . && node dist/examples/login/run.js"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@types/node": "^22",
    "typescript": "5.6.3"
  },
  "license": "UNLICENSED",
  "files": [
    "dist/src",
    "wasm"
  ]
}
